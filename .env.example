# ---------------------------------------------------------------------------
# sam-ai environment configuration
#
# Copy this file to `.env` (git-ignored) and adjust values for your machine.
# Optional personal overrides can go in `.env.local` (also git-ignored).
# Real environment variables always win over values in these files.
#
#   API vars  -> validated at startup in apps/api/src/config/env.ts
#   UI_*  vars -> exposed to the browser by Vite. NEVER put secrets in UI_* vars.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API server -------------------------------------------------------------
API_PORT=3333
# true = if API_PORT is busy, try the next ports (UI_API_BASE_URL may then be wrong)
API_PORT_FALLBACK=false

# --- MongoDB (used by the Python research service: stored daily bars, predictions) ---
MONGO_URI=mongodb://127.0.0.1:27017/sam-ai

# --- CSE data source (live public cse.lk API; there is no sample-data mode) --
CSE_API_BASE_URL=https://www.cse.lk/api

# --- Research results (written by the Python pipeline) ---------------------
RESEARCH_RESULTS_DIR=research/results
# Python research service (cd research && python -m uvicorn cse_xai.service:app --port 8001)
RESEARCH_SERVICE_URL=http://127.0.0.1:8001

# --- LLM for the agents ------------------------------------------------------
MASTRA_ENABLED=false
# openai (default) or anthropic
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# --- UI (exposed to the browser) ------------------------------------------
UI_PORT=3000
UI_API_BASE_URL=http://localhost:3333/api
