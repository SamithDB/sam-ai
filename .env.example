# ---------------------------------------------------------------------------
# sam-ai environment configuration
#
# Copy this file to `.env` (git-ignored) and adjust values for your machine.
# Optional personal overrides can go in `.env.local` (also git-ignored).
# Real environment variables always win over values in these files.
#
#   API vars  -> validated at startup in apps/api/src/config/env.ts
#   UI_*  vars -> exposed to the browser by Vite. NEVER put secrets in UI_* vars.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API server -------------------------------------------------------------
API_PORT=3333
# true = if API_PORT is busy, try the next ports (UI_API_BASE_URL may then be wrong)
API_PORT_FALLBACK=false

# --- MongoDB ----------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/sam-ai

# --- CSE data source --------------------------------------------------------
# Leave empty to use the built-in fixture data.
CSE_API_BASE_URL=

# --- Mastra / LLM -----------------------------------------------------------
MASTRA_ENABLED=false
MASTRA_MODEL=openai/gpt-5-mini
OPENAI_API_KEY=

# --- UI (exposed to the browser) ------------------------------------------
UI_PORT=3000
UI_API_BASE_URL=http://localhost:3333/api
